# Copy this file to .env and fill in the values.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-with-a-strong-random-hex-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_NAME=dms_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ── Application ───────────────────────────────────────────────────────────────
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_EXPIRY_MINUTES=60

# ── SAP RFC Integration (dormant — set SAP_RFC_ENABLED=True to activate) ──────
# Requires: pip install pyrfc  +  SAP NetWeaver RFC SDK installed on the server.
# See Backend/api/sap_rfc.py for full documentation and usage.
SAP_RFC_ENABLED=False
SAP_ASHOST=                   # SAP application server IP or hostname
SAP_SYSNR=00                  # System number (2 digits)
SAP_CLIENT=100                # SAP client / Mandant
SAP_RFC_USER=                 # Technical RFC user (created in SAP SU01)
SAP_RFC_PASSWORD=             # RFC user password
SAP_LANG=EN                   # Logon language
